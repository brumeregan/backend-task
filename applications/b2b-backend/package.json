{
  "name": "@qred/b2b-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm test:e2e",
    "test:integration": "vitest run",
    "test:e2e": "tsup && vitest run -c vitest.e2e.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/cli.ts seed",
    "db:reset": "tsx --env-file-if-exists=.env src/cli.ts reset"
  },
  "dependencies": {
    "@qred/b2b-app-schemas": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.22.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "http-graceful-shutdown": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sequelize": "^6.37.7",
    "umzug": "^3.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/express-serve-static-core": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "vitest": "^3.2.4"
  }
}
