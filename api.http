@erikToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3OTI1MDE3NjAsImlzcyI6InFyZWQtbW9jay1hdXRoIiwic3ViIjoiYTAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAyIn0.DDli2ntwA3r2Uintim4cWiR7MxEwGMDexlA4hIG8WIs
