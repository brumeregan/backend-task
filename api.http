# Static seed IDs (applications/b2b-backend/src/db/seed.ts)
@companyAb = b0000000-0000-4000-8000-000000000001
@nordicTrade = b0000000-0000-4000-8000-000000000002
@annaInactiveCard = d0000000-0000-4000-8000-000000000001
@erikActiveCard = d0000000-0000-4000-8000-000000000002
@erikFrozenCard = d0000000-0000-4000-8000-000000000003
@saraActiveCard = d0000000-0000-4000-8000-000000000004
